# LLM Gateway — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Provider selection
PROVIDER_NAME=mock

# Provider connection
PROVIDER_BASE_URL=http://127.0.0.1:9000
PROVIDER_API_KEY=

# Model defaults
PROVIDER_MODEL=mock-model

# Timeouts (seconds, floats accepted)
REQUEST_TIMEOUT=30.0

# Generation limits
MAX_OUTPUT_TOKENS=2048

# Concurrency / queue
CONCURRENCY_LIMIT=50
QUEUE_SIZE=200
QUEUE_WAIT_TIMEOUT=10.0

# Retry
MAX_ATTEMPTS=3

# Feature flags (baseline = all OFF)
REUSE_HTTP_CLIENT=false
POOL_MAX_KEEPALIVE=20
POOL_MAX_CONNECTIONS=100
